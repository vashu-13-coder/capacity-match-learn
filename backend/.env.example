# Flask Core Config
SECRET_KEY=super-secret-capacityconnect-key-change-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-in-prod
FLASK_ENV=production

# Database (PostgreSQL or SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/capacityconnect_db

# AWS Cloud Storage Settings (S3 Signed URLs)
AWS_S3_BUCKET=capacity-connect-media-storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Transactional Email (SendGrid / AWS SES)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@capacityconnect.com
